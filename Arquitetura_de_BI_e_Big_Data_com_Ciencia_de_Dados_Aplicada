        "# ==============================================================================\n",
        "# ETAPA 2 - MODELOS PREDITIVOS (XGBOOST E PO)\n",
        "# ==============================================================================\n",
        "def prever_demanda(df_demanda):\n",
        "    print(\"--- [ETAPA MACHINE LEARNING] PREVISÃO DE DEMANDA (XGBOOST) ---\")\n",
        "    resultados_ml = {}\n",
        "\n",
        "    for p_id in df_demanda['Produto_ID'].unique():\n",
        "        df_p = df_demanda[df_demanda['Produto_ID'] == p_id].copy()\n",
        "\n",
        "        # Feature Engineering\n",
        "        df_p['Lag_1'] = df_p['Demanda_Diaria'].shift(1)\n",
        "        df_p['Lag_7'] = df_p['Demanda_Diaria'].shift(7)\n",
        "        df_p['Lag_30'] = df_p['Demanda_Diaria'].shift(30)\n",
        "        df_p['Media_Movel_7'] = df_p['Demanda_Diaria'].rolling(window=7).mean()\n",
        "        df_p['Desvio_Movel_7'] = df_p['Demanda_Diaria'].rolling(window=7).std()\n",
        "\n",
        "        df_p = df_p.dropna()\n",
        "\n",
        "        features = ['Dia_Semana', 'Mes', 'Sazonalidade', 'Lag_1', 'Lag_7', 'Lag_30', 'Media_Movel_7', 'Desvio_Movel_7']\n",
        "        X = df_p[features]\n",
        "        y = df_p['Demanda_Diaria']\n",
        "\n",
        "        # Divisão Temporal (Sem shuffle)\n",
        "        # Treino: 70%, Val: 15%, Teste: 15%\n",
        "        n = len(X)\n",
        "        train_idx, val_idx = int(n * 0.7), int(n * 0.85)\n",
        "\n",
        "        X_train, y_train = X.iloc[:train_idx], y.iloc[:train_idx]\n",
        "        X_test, y_test = X.iloc[val_idx:], y.iloc[val_idx:]\n",
        "\n",
        "        model = XGBRegressor(n_estimators=100, learning_rate=0.1, random_state=42, objective='reg:squarederror')\n",
        "        model.fit(X_train, y_train)\n",
        "\n",
        "        y_pred = model.predict(X_test)\n",
        "\n",
        "        mape = mean_absolute_percentage_error(y_test, y_pred)\n",
        "        rmse = np.sqrt(mean_squared_error(y_test, y_pred))\n",
        "        mae = mean_absolute_error(y_test, y_pred)\n",
        "\n",
        "        # Demanda prevista para os próximos 30 dias (média diária baseada no último mês de teste)\n",
        "        demanda_futura_diaria = y_pred[-30:].mean()\n",
        "\n",
        "        resultados_ml[p_id] = {\n",
        "            'MAPE': mape,\n",
        "            'RMSE': rmse,\n",
        "            'MAE': mae,\n",
        "            'Demanda_Diaria_Prevista': demanda_futura_diaria\n",
        "        }\n",
        "\n",
        "    print(f\"Produto 1 (Alpha) -> MAPE: {resultados_ml[1]['MAPE']:.2%} | RMSE: {resultados_ml[1]['RMSE']:.2f}\")\n",
        "    return resultados_ml\n",
        "\n",
        "def otimizar_compras(df_produtos, df_fornecedores, resultados_ml, resumo_estoque):\n",
        "    print(\"\\n--- [ETAPA PO] OTIMIZAÇÃO DE COMPRAS ---\")\n",
        "    recomendacoes_compra = []\n",
        "\n",
        "    # Iterar por produtos\n",
        "    for _, prod in df_produtos.iterrows():\n",
        "        p_id = prod['Produto_ID']\n",
        "        nome = prod['Produto']\n",
        "        demanda_prevista_mensal = resultados_ml[p_id]['Demanda_Diaria_Prevista'] * 30\n",
        "        estoque_atual = resumo_estoque[resumo_estoque['Produto_ID'] == p_id]['Estoque_Medio'].values[0]\n",
        "        estoque_seguranca = 1.65 * resumo_estoque[resumo_estoque['Produto_ID'] == p_id]['Desvio_Demanda'].values[0] * math.sqrt(7)\n",
        "\n",
        "        necessidade_compra = max(0, (demanda_prevista_mensal + estoque_seguranca) - estoque_atual)\n",
        "\n",
        "        if necessidade_compra > 0:\n",
        "            if PULP_AVAILABLE:\n",
        "                # Otimização Linear com PuLP\n",
        "                prob = pulp.LpProblem(f\"Otimizacao_Compras_{p_id}\", pulp.LpMinimize)\n",
        "\n",
        "                forn_vars = {}\n",
        "                for _, f in df_fornecedores.iterrows():\n",
        "                    var = pulp.LpVariable(f\"compra_{f['ID_Fornecedor']}\", lowBound=0, cat='Continuous')\n",
        "                    forn_vars[f['ID_Fornecedor']] = var\n",
        "\n",
        "                # Função Objetivo: Minimizar Custo = (Custo Unit * Mult + Transp) * Qtd + Penalidade Qualidade\n",
        "                custo_total = []\n",
        "                for _, f in df_fornecedores.iterrows():\n",
        "                    c_unit = prod['Custo_Unitario'] * f['Custo_Unitario_Mult']\n",
        "                    c_transp = f['Custo_Transporte']\n",
        "                    penalidade = (1 - f['Taxa_Qualidade_Rececao']) * 50 # Peso penalidade\n",
        "                    custo_total.append(forn_vars[f['ID_Fornecedor']] * (c_unit + c_transp + penalidade))\n",
        "\n",
        "                prob += pulp.lpSum(custo_total)\n",
        "\n",
        "                # Restrição: Demanda\n",
        "                prob += pulp.lpSum(forn_vars.values()) >= necessidade_compra\n",
        "\n",
        "                # Restrição: Capacidade (Simulação estática)\n",
        "                for f_id in forn_vars:\n",
        "                    prob += forn_vars[f_id] <= 500 # Limite por fornecedor\n",
        "\n",
        "                prob.solve(pulp.PULP_CBC_CMD(msg=0))\n",
        "\n",
        "                for _, f in df_fornecedores.iterrows():\n",
        "                    qtd = forn_vars[f['ID_Fornecedor']].varValue\n",
        "                    if qtd > 0:\n",
        "                        recomendacoes_compra.append({\n",
        "                            'Produto': nome,\n",
        "                            'Fornecedor': f['Fornecedor'],\n",
        "                            'Quantidade': round(qtd),\n",
        "                            'Custo_Unitario': prod['Custo_Unitario'] * f['Custo_Unitario_Mult'],\n",
        "                            'Justificativa': 'Otimização Matemática (Menor Custo Integrado)'\n",
        "                        })\n",
        "            else:\n",
        "                # Heurística caso PuLP não exista\n",
        "                f_melhor = df_fornecedores.sort_values('Custo_Transporte').iloc[0]\n",
        "                recomendacoes_compra.append({\n",
        "                    'Produto': nome,\n",
        "                    'Fornecedor': f_melhor['Fornecedor'],\n",
        "                    'Quantidade': round(necessidade_compra),\n",
        "                    'Custo_Unitario': prod['Custo_Unitario'] * f_melhor['Custo_Unitario_Mult'],\n",
        "                    'Justificativa': 'Heurística Gananciosa (Sem Solver)'\n",
        "                })\n",
        "\n",
        "    df_recomendacoes = pd.DataFrame(recomendacoes_compra)\n",
        "    print(df_recomendacoes.to_string(index=False))\n",
        "    return df_recomendacoes\n",
        "\n",
        "def calcular_estoque(resumo_estoque, df_fornecedores):\n",
        "    print(\"\\n--- [ETAPA PO] PARAMETRIZAÇÃO DE ESTOQUE ---\")\n",
        "    lt_medio_global = df_fornecedores['Lead_Time_Medio_Dias'].mean()\n",
        "    Z = 1.65 # 95% Nível de Serviço\n",
        "\n",
        "    resumo_estoque['Estoque_Seguranca_Novo'] = Z * resumo_estoque['Desvio_Demanda'] * math.sqrt(lt_medio_global)\n",
        "    resumo_estoque['Ponto_Pedido_Novo'] = (resumo_estoque['Demanda_Media'] * lt_medio_global) + resumo_estoque['Estoque_Seguranca_Novo']\n",
        "\n",
        "    print(resumo_estoque[['Produto', 'Estoque_Seguranca_Novo', 'Ponto_Pedido_Novo']].round(0).to_string(index=False))\n",
        "    return resumo_estoque\n",
        "\n",
        "def otimizar_rotas(df_rotas):\n",
        "    print(\"\\n--- [ETAPA ROTEAMENTO VRP] HEURÍSTICA CLARKE-WRIGHT SAVINGS ---\")\n",
        "\n",
        "    # Dicionário de nós\n",
        "    nos = df_rotas.set_index('Cliente_ID').to_dict('index')\n",
        "    n_clientes = len(nos) - 1 # Nó 0 é o CD\n",
        "    capacidade_veiculo = 40\n",
        "\n",
        "    def dist(n1, n2):\n",
        "        return math.hypot(nos[n1]['Latitude'] - nos[n2]['Latitude'],\n",
        "                          nos[n1]['Longitude'] - nos[n2]['Longitude'])\n",
        "\n",
        "    # Distância Inicial (Rotas de ida e volta individuais)\n",
        "    distancia_original = sum(2 * dist(0, i) for i in range(1, n_clientes + 1))\n",
        "\n",
        "    # Cálculo de Savings\n",
        "    savings = []\n",
        "    for i in range(1, n_clientes + 1):\n",
        "        for j in range(i + 1, n_clientes + 1):\n",
        "            s = dist(i, 0) + dist(0, j) - dist(i, j)\n",
        "            savings.append((s, i, j))\n",
        "\n",
        "    savings.sort(reverse=True, key=lambda x: x[0])\n",
        "\n",
        "    # Construção das Rotas\n",
        "    rotas = [[i] for i in range(1, n_clientes + 1)]\n",
        "\n",
        "    for s, i, j in savings:\n",
        "        # Achar em quais rotas i e j estão\n",
        "        rota_i = next((r for r in rotas if r[-1] == i), None) # i precisa estar no final\n",
        "        rota_j = next((r for r in rotas if r[0] == j), None)  # j precisa estar no começo\n",
        "\n",
        "        if rota_i and rota_j and rota_i != rota_j:\n",
        "            # Checar restrição de capacidade\n",
        "            demanda_total = sum(nos[node]['Demanda'] for node in rota_i + rota_j)\n",
        "            if demanda_total <= capacidade_veiculo:\n",
        "                rota_i.extend(rota_j)\n",
        "                rotas.remove(rota_j)\n",
        "\n",
        "    distancia_otimizada = 0\n",
        "    print(\"Rotas Finais:\")\n",
        "    for idx, rota in enumerate(rotas, 1):\n",
        "        caminho = [0] + rota + [0]\n",
        "        demanda_rota = sum(nos[node]['Demanda'] for node in rota)\n",
        "\n",
        "        dist_rota = 0\n",
        "        for k in range(len(caminho)-1):\n",
        "            dist_rota += dist(caminho[k], caminho[k+1])\n",
        "        distancia_otimizada += dist_rota\n",
        "\n",
        "        rota_str = \" -> \".join(f\"Nó {n}\" if n != 0 else \"CD\" for n in caminho)\n",
        "        print(f\"Veículo {idx}: {rota_str}\")\n",
        "        print(f\"   L Carga: {demanda_rota}/{capacidade_veiculo} | Distância: {dist_rota:.2f} km\")\n",
        "\n",
        "    economia = (1 - (distancia_otimizada / distancia_original)) * 100\n",
        "    print(f\"\\nResultado Roteamento: Distância Original = {distancia_original:.2f} km | Otimizada = {distancia_otimizada:.2f} km\")\n",
        "    print(f\"Economia Logística: {economia:.2f}% de redução em transporte.\")\n",
        "\n",
        "    return distancia_original, distancia_otimizada, economia\n",
        "\n",
        "# ==============================================================================\n",
        "# ETAPA 3 - MELHORIAS, KPIS E RELATÓRIO EXECUTIVO\n",
        "# ==============================================================================\n",
        "def gerar_kpis(kpis_fornecedor, resumo_estoque, dist_orig, dist_otim):\n",
        "    kpis = {\n",
        "        'Lead_Time_Medio_Atual': kpis_fornecedor['Media_Tempo_Entrega'].mean(),\n",
        "        'Atrasos_Atual': kpis_fornecedor['Perc_Atrasados'].mean(),\n",
        "        'Estoque_Medio_Atual': resumo_estoque['Estoque_Medio'].sum(),\n",
        "        'Distancia_Atual': dist_orig\n",
        "    }\n",
        "\n",
        "    # Projeção de melhoria (Simulação de adoção das ações)\n",
        "    kpis['Lead_Time_Medio_Futuro'] = kpis['Lead_Time_Medio_Atual'] * 0.8  # Redução de 20%\n",
        "    kpis['Atrasos_Futuro'] = kpis['Atrasos_Atual'] * 0.4                  # Redução de 60% focado no F2\n",
        "    kpis['Estoque_Medio_Futuro'] = kpis['Estoque_Medio_Atual'] * 0.85     # Otimização de SS\n",
        "    kpis['Distancia_Futuro'] = dist_otim\n",
        "\n",
        "    print(\"\\n--- MONITORAMENTO E KPIS (ANTES E DEPOIS) ---\")\n",
        "    print(f\"{'Indicador':<25} {'Antes':<15} {'Depois (Proj.)':<15} {'Melhoria'}\")\n",
        "    print(\"-\" * 70)\n",
        "    print(f\"{'Lead Time Médio (Dias)':<25} {kpis['Lead_Time_Medio_Atual']:<15.1f} {kpis['Lead_Time_Medio_Futuro']:<15.1f} {-20.0:.1f}%\")\n",
        "    print(f\"{'Pedidos em Atraso (%)':<25} {kpis['Atrasos_Atual']:<15.1f} {kpis['Atrasos_Futuro']:<15.1f} {-60.0:.1f}%\")\n",
        "    print(f\"{'Estoque Físico Total':<25} {kpis['Estoque_Medio_Atual']:<15.0f} {kpis['Estoque_Medio_Futuro']:<15.0f} {-15.0:.1f}%\")\n",
        "    print(f\"{'Distância Rotas (km)':<25} {kpis['Distancia_Atual']:<15.1f} {kpis['Distancia_Futuro']:<15.1f} {((dist_otim/dist_orig)-1)*100:.1f}%\")\n",
        "\n",
        "    return kpis\n",
