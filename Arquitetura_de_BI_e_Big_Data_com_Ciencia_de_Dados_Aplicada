        "def analise_fornecedores(kpis_fornecedor):\n",
        "    # Score ponderado: Menor atraso (+), Menor tempo entrega (+), Maior Qualidade (+)\n",
        "    # Normalização min-max invertida para custos e atrasos\n",
        "    kf = kpis_fornecedor.copy()\n",
        "\n",
        "    # Normalização\n",
        "    norm_atraso = 1 - (kf['Perc_Atrasados'] / kf['Perc_Atrasados'].max())\n",
        "    norm_lt = 1 - (kf['Media_Tempo_Entrega'] / kf['Media_Tempo_Entrega'].max())\n",
        "    norm_qualidade = kf['Taxa_Qualidade_Rececao'] / kf['Taxa_Qualidade_Rececao'].max()\n",
        "\n",
        "    kf['Score_Fornecedor'] = (norm_atraso * 0.4) + (norm_lt * 0.3) + (norm_qualidade * 0.3)\n",
        "    kf = kf.sort_values('Score_Fornecedor', ascending=False)\n",
        "\n",
        "    return kf\n",
